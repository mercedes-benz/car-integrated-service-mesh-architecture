<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00050.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>RB</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>VRTE</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>ServiceInterfaceDeployments</SHORT-NAME>
              <ELEMENTS>
                <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
                  <SHORT-NAME>Method</SHORT-NAME>
                  <METHOD-DEPLOYMENTS>
                    <SOMEIP-METHOD-DEPLOYMENT>
                      <SHORT-NAME>MethodIO</SHORT-NAME>
                      <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/mercedes_benz/com/AraCM_Method_Benchmark/MethodIO</METHOD-REF>
                      <METHOD-ID>12</METHOD-ID>
                      <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                    </SOMEIP-METHOD-DEPLOYMENT>
                  </METHOD-DEPLOYMENTS>
                  <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/mercedes_benz/com/AraCM_Method_Benchmark</SERVICE-INTERFACE-REF>
                  <SERVICE-INTERFACE-ID>11</SERVICE-INTERFACE-ID>
                  <SERVICE-INTERFACE-VERSION>
                    <MAJOR-VERSION>1</MAJOR-VERSION>
                    <MINOR-VERSION>0</MINOR-VERSION>
                  </SERVICE-INTERFACE-VERSION>
                </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>ServiceInstances</SHORT-NAME>
              <ELEMENTS>
                <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                  <SHORT-NAME>MachineDesign_A_PSSI</SHORT-NAME>
                  <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/RB/VRTE/ServiceInterfaceDeployments/Method</SERVICE-INTERFACE-DEPLOYMENT-REF>
                  <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/RB/VRTE/SomeipSdTimingConfigs/MachineDesign_A_SSDSSIC</SD-SERVER-CONFIG-REF>
                  <SERVICE-INSTANCE-ID>34343</SERVICE-INSTANCE-ID>
                </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                <REQUIRED-SOMEIP-SERVICE-INSTANCE>
                  <SHORT-NAME>MachineDesign_B_RSSI</SHORT-NAME>
                  <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/RB/VRTE/ServiceInterfaceDeployments/Method</SERVICE-INTERFACE-DEPLOYMENT-REF>
                  <REQUIRED-MINOR-VERSION>0</REQUIRED-MINOR-VERSION>
                  <REQUIRED-SERVICE-INSTANCE-ID>34343</REQUIRED-SERVICE-INSTANCE-ID>
                  <SD-CLIENT-CONFIG-REF DEST="SOMEIP-SD-CLIENT-SERVICE-INSTANCE-CONFIG">/RB/VRTE/SomeipSdTimingConfigs/MachineDesign_B_SSDCSIC</SD-CLIENT-CONFIG-REF>
                  <VERSION-DRIVEN-FIND-BEHAVIOR>MINIMUM-MINOR-VERSION</VERSION-DRIVEN-FIND-BEHAVIOR>
                </REQUIRED-SOMEIP-SERVICE-INSTANCE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>SomeipSdTimingConfigs</SHORT-NAME>
              <ELEMENTS>
                <SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG>
                  <SHORT-NAME>MachineDesign_A_SSDSSIC</SHORT-NAME>
                  <INITIAL-OFFER-BEHAVIOR>
                    <INITIAL-DELAY-MAX-VALUE>1.0</INITIAL-DELAY-MAX-VALUE>
                    <INITIAL-DELAY-MIN-VALUE>0.1</INITIAL-DELAY-MIN-VALUE>
                    <INITIAL-REPETITIONS-BASE-DELAY>0.2</INITIAL-REPETITIONS-BASE-DELAY>
                    <INITIAL-REPETITIONS-MAX>3</INITIAL-REPETITIONS-MAX>
                  </INITIAL-OFFER-BEHAVIOR>
                  <OFFER-CYCLIC-DELAY>10.0</OFFER-CYCLIC-DELAY>
                  <REQUEST-RESPONSE-DELAY>
                    <MAX-VALUE>10.0</MAX-VALUE>
                    <MIN-VALUE>1.0</MIN-VALUE>
                  </REQUEST-RESPONSE-DELAY>
                  <SERVICE-OFFER-TIME-TO-LIVE>50</SERVICE-OFFER-TIME-TO-LIVE>
                </SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG>
                <SOMEIP-SD-CLIENT-SERVICE-INSTANCE-CONFIG>
                  <SHORT-NAME>MachineDesign_B_SSDCSIC</SHORT-NAME>
                  <INITIAL-FIND-BEHAVIOR>
                    <INITIAL-DELAY-MAX-VALUE>1.0</INITIAL-DELAY-MAX-VALUE>
                    <INITIAL-DELAY-MIN-VALUE>0.1</INITIAL-DELAY-MIN-VALUE>
                    <INITIAL-REPETITIONS-BASE-DELAY>0.2</INITIAL-REPETITIONS-BASE-DELAY>
                    <INITIAL-REPETITIONS-MAX>3</INITIAL-REPETITIONS-MAX>
                  </INITIAL-FIND-BEHAVIOR>
                  <SERVICE-FIND-TIME-TO-LIVE>100</SERVICE-FIND-TIME-TO-LIVE>
                </SOMEIP-SD-CLIENT-SERVICE-INSTANCE-CONFIG>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>ServiceInstanceToMachineMappings</SHORT-NAME>
              <ELEMENTS>
                <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                  <SHORT-NAME>MachineDesign_A_SSITMM</SHORT-NAME>
                  <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/MachineDesign_A/MachineDesign_A/MachineDesign_A_ECC</COMMUNICATION-CONNECTOR-REF>
                  <SERVICE-INSTANCE-REFS>
                    <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/RB/VRTE/ServiceInstances/MachineDesign_A_PSSI</SERVICE-INSTANCE-REF>
                  </SERVICE-INSTANCE-REFS>
                  <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/MachineDesign_A/MachineDesign_A/MachineDesign_A_ECC/MachineDesign_A_SSITMM_udpPort_5000</UDP-PORT-REF>
                </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                  <SHORT-NAME>MachineDesign_B_SSITMM</SHORT-NAME>
                  <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/MachineDesigns/MachineDesign_B/MachineDesign_B_ECC</COMMUNICATION-CONNECTOR-REF>
                  <SERVICE-INSTANCE-REFS>
                    <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/RB/VRTE/ServiceInstances/MachineDesign_B_RSSI</SERVICE-INSTANCE-REF>
                  </SERVICE-INSTANCE-REFS>
                  <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/MachineDesigns/MachineDesign_B/MachineDesign_B_ECC/MachineDesign_B_SSITMM_udpPort_5000</UDP-PORT-REF>
                </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>ServiceInstanceToPortPrototypeMappings</SHORT-NAME>
              <ELEMENTS>
                <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                  <SHORT-NAME>MachineDesign_A_PSSI_PPort</SHORT-NAME>
                  <PORT-PROTOTYPE-IREF>
                    <CONTEXT-ROOT-SW-COMPONENT-PROTOTYPE-REF DEST="ROOT-SW-COMPONENT-PROTOTYPE">/RB/VRTE/Executables/Publisher/Publisher_RootSwComponent</CONTEXT-ROOT-SW-COMPONENT-PROTOTYPE-REF>
                    <TARGET-PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/mercedes_benz/com/AraCM_Method_Benchmark_Component/PPort</TARGET-PORT-PROTOTYPE-REF>
                  </PORT-PROTOTYPE-IREF>
                  <PROCESS-REF DEST="PROCESS">/RB/VRTE/Processes/Publisher_Process</PROCESS-REF>
                  <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/RB/VRTE/ServiceInstances/MachineDesign_A_PSSI</SERVICE-INSTANCE-REF>
                </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                  <SHORT-NAME>MachineDesign_B_RSSI_RPort</SHORT-NAME>
                  <PORT-PROTOTYPE-IREF>
                    <CONTEXT-ROOT-SW-COMPONENT-PROTOTYPE-REF DEST="ROOT-SW-COMPONENT-PROTOTYPE">/RB/VRTE/Executables/Subscriber/Subscriber_RootSwComponent</CONTEXT-ROOT-SW-COMPONENT-PROTOTYPE-REF>
                    <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/mercedes_benz/com/AraCM_Method_Benchmark_Component/RPort</TARGET-PORT-PROTOTYPE-REF>
                  </PORT-PROTOTYPE-IREF>
                  <PROCESS-REF DEST="PROCESS">/RB/VRTE/Processes/Subscriber_Process</PROCESS-REF>
                  <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/RB/VRTE/ServiceInstances/MachineDesign_B_RSSI</SERVICE-INSTANCE-REF>
                </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
              </ELEMENTS>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
